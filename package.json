{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:assets",
        "build:assets": "npm run build:css && npm run build:css:signing && npm run build:js && npm run build:js:signing",
        "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/ngn/app.css --minify",
        "build:css:signing": "esbuild ./resources/css/agreement-signing-public.css --bundle --minify --outfile=./public/assets/ngn/agreement-signing-public.css --loader:.css=css --loader:.woff2=file --loader:.woff=file --loader:.ttf=file",
        "build:js": "esbuild ./resources/js/app.js --bundle --minify --outfile=./public/assets/ngn/app.js --format=iife",
        "build:js:signing": "esbuild ./resources/js/agreement-signing-public.js --bundle --minify --outfile=./public/assets/ngn/agreement-signing-public.js --format=iife",
        "dev:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/ngn/app.css --watch",
        "dev:js": "esbuild ./resources/js/app.js --bundle --outfile=./public/assets/ngn/app.js --format=iife --watch"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "autoprefixer": "^10.4.20",
        "axios": "^0.28.1",
        "esbuild": "^0.25.12",
        "postcss": "^8.4.41",
        "tailwind-scrollbar": "^3.1.0",
        "tailwindcss": "^3.4.17"
    },
    "dependencies": {
        "@alpinejs/focus": "^3.14.1",
        "@alpinejs/intersect": "^3.14.1",
        "@alpinejs/persist": "^3.14.1",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/typography": "^0.5.15",
        "alpinejs": "^3.14.1",
        "bootstrap": "^5.3.3",
        "chart.js": "^4.3.1",
        "jquery": "^3.7.1",
        "laravel-echo": "^1.19.0",
        "pusher-js": "^8.4.0-rc2"
    }
}
